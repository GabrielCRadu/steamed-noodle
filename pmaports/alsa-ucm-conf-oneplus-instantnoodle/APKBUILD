# codec confirmed in reference/dts/sm8250-oneplus-instantnoodle.dts
# (qcom,wcd9380-codec) - consistent with the rest of this document's audio
# findings, not just copy-pasted from a similarly-named device.
maintainer=""
pkgname=alsa-ucm-conf-oneplus-instantnoodle
pkgver=1
pkgrel=0
pkgdesc="ALSA UCM configuration for OnePlus 8 (instantnoodle)"
url="https://github.com/Xo666/linux-oneplus-instantnoodle"
arch="aarch64"

options="!check"
_commit="9e645da0ce76ccb7594d5b2da6fb43fe374b6897"
source="$pkgname-$_commit.tar.gz::https://github.com/Xo666/linux-oneplus-instantnoodle/archive/$_commit.tar.gz"
builddir="$srcdir/linux-oneplus-instantnoodle-$_commit"

package() {
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2
	cp -r "$builddir/alsa-oneplus-instantnoodle/usr/share/alsa/ucm2/OnePlus" \
		"$pkgdir"/usr/share/alsa/ucm2/
}


# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.
#
# DRAFT, not verified on hardware. Adapted from the packaged
# device-oneplus-instantnoodlep (OnePlus 8 Pro) port, since the two devices
# share the same SM8250 platform, generation, and ABL bootloader. Flash
# offsets and the super-partition path are cross-checked against the
# `fastboot getvar all` / by-name partition dump for an actual OnePlus 8
# (see docs/verification-log.md) and match instantnoodlep's values exactly -
# not yet confirmed to be identical for every field, but no evidence of
# divergence so far. Screen resolution and codename are corrected for the
# non-Pro model.
#
# BRICK-RISK AUDIT (2026-08-24, local-only notes, not tracked in this repo):
# - deviceinfo_super_partitions below is NOT read by pmbootstrap at all (no
#   such field exists in its Deviceinfo schema - confirmed by reading
#   pmb/parse/deviceinfo.py directly). It does nothing. The real
#   instantnoodlep port carries the same dead field, so this isn't a
#   mistake unique to this draft, but do not assume it provides any of the
#   dynamic-partition safety its presence implies.
# - deviceinfo_flash_fastboot_partition_vbmeta was ADDED below after an
#   audit found neither this draft nor the real instantnoodlep port set it,
#   which means pmbootstrap silently skips disabling AVB verification
#   during install. Whether this device actually needs that step is still
#   unconfirmed, but the partition name itself ("vbmeta") is confirmed from
#   the real by-name partition dump the user supplied (vbmeta ->
#   .../by-name/vbmeta_b, i.e. an A/B-slotted vbmeta partition exists on
#   this exact phone).
# - There is still no backup-before-flash step anywhere in this project's
#   documented flow. Get a verified stock OxygenOS restore package before
#   touching real hardware.

deviceinfo_format_version="0"
deviceinfo_name="OnePlus 8"
deviceinfo_manufacturer="OnePlus"
deviceinfo_codename="oneplus-instantnoodle"
deviceinfo_year="2020"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_screen_width="1080"
deviceinfo_screen_height="2400"

# Bootloader related
deviceinfo_flash_method="fastboot"
deviceinfo_generate_bootimg="true"
deviceinfo_flash_pagesize="4096"
deviceinfo_header_version="2"
deviceinfo_dtb="qcom/sm8250-oneplus-instantnoodle"
deviceinfo_flash_offset_dtb="0x01f00000"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01000000"
deviceinfo_flash_offset_second="0x00000000"
deviceinfo_flash_offset_tags="0x00000100"
deviceinfo_flash_fastboot_partition_rootfs="super"
deviceinfo_flash_fastboot_partition_dtbo="dtbo"
deviceinfo_flash_fastboot_partition_vbmeta="vbmeta"
deviceinfo_super_partitions="/dev/sda14 /dev/sda14"
deviceinfo_rootfs_image_sector_size="4096"
deviceinfo_flash_sparse="true"

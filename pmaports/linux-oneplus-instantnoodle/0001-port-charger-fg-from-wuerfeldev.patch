# Port pm8150b charger and fuel-gauge support from WuerfelDev/linux-sm8250
#
# This tree (Xo666/mainline-instantnoodle, branch 6.16.7) is used as the
# reference kernel throughout this project because it is the only known
# fork with a fully-wired, working GPU (zap-shader firmware path correctly
# declared in the &gpu node). Its downside, documented in
# docs/verification-log.md sections 1.4 and 4 of the steamos-android repo,
# is that it has no battery charger support at all: pm8150b.dtsi simply
# lacks the charger/fuel-gauge device tree nodes.
#
# The WuerfelDev/linux-sm8250 fork (branch 6.17.0-instantnoodle) has working
# charger and fuel-gauge nodes, but ships with the GPU explicitly disabled
# in its board DTS. Nobody had ported the charger support onto the
# GPU-working tree before this patch.
#
# This patch ports, byte-for-byte, the three pieces WuerfelDev's
# pm8150b.dtsi has that Xo666's lacks:
#   1. The pm8150b_charger (qcom,pm8150b-charger) node.
#   2. Two ADC channel sub-nodes (channel@7 = usb_in_i_uv, channel@8 =
#      usb_in_v_div_16) on the shared pm8150b_adc node.
#   3. The pm8150b_fg (qcom,pm8150b-fg) node.
#
# It then adds a board-level override block to
# sm8250-oneplus-instantnoodle.dts, matching WuerfelDev's board DTS
# override for &pm8150b_charger / &pm8150b_fg, plus the two additional
# board-level ADC channels (channel@83 = vph_pwr, channel@99 = chg_sbux)
# that WuerfelDev's board DTS adds to &pm8150b_adc. ADC5_CHG_TEMP already
# exists in Xo666's own pm8150b_adc as channel@9, and is reused rather than
# duplicated.
#
# Nothing related to the GPU, the zap-shader node, or the SBU mux/typec
# orientation-switch wiring is touched by this patch - those already work
# correctly in the Xo666 tree and are left exactly as-is.
#
# Source: WuerfelDev/linux-sm8250, branch 6.17.0-instantnoodle, fetched
# 2026-08-24 from gitlab.postmarketos.org (pm8150b.dtsi and
# sm8250-oneplus-instantnoodle.dts).
#
# Status: compile-verified only (raw dtc build with zero warnings/errors on
# the changed nodes, plus a full pmbootstrap/abuild package build - see
# docs/verification-log.md for exact commands and results). This has NOT
# been tested on real hardware. It is not known whether the charger or
# fuel-gauge actually initialize or report correct values on an actual
# OnePlus 8; this patch only proves the device tree parses, cross-references
# resolve, and the kernel/dtb build succeeds with the new nodes present and
# enabled.
#
diff --git a/arch/arm64/boot/dts/qcom/pm8150b.dtsi b/arch/arm64/boot/dts/qcom/pm8150b.dtsi
index 3f7b0b6a1..4e9778c35 100644
--- a/arch/arm64/boot/dts/qcom/pm8150b.dtsi
+++ b/arch/arm64/boot/dts/qcom/pm8150b.dtsi
@@ -107,6 +107,26 @@ pm8150b_temp: temp-alarm@2400 {
 			#thermal-sensor-cells = <0>;
 		};

+		pm8150b_charger: charger@1000 {
+			compatible = "qcom,pm8150b-charger";
+			reg = <0x1000>;
+
+			interrupts = <0x2 0x13 0x4 IRQ_TYPE_EDGE_BOTH>,
+				     <0x2 0x12 0x2 IRQ_TYPE_EDGE_BOTH>,
+				     <0x2 0x16 0x1 IRQ_TYPE_EDGE_RISING>,
+				     <0x2 0x13 0x7 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "usbin-plugin",
+					  "bat-ov",
+					  "wdog-bark",
+					  "usbin-icl-change";
+
+			io-channels = <&pm8150b_adc 7>,
+				      <&pm8150b_adc 8>;
+			io-channel-names = "usb_in_i_uv", "usb_in_v_div_16";
+
+			status = "disabled";
+		};
+
 		pm8150b_adc: adc@3100 {
 			compatible = "qcom,spmi-adc5";
 			reg = <0x3100>;
@@ -133,6 +153,18 @@ channel@6 {
 				label = "die_temp";
 			};

+			channel@7 {
+				reg = <ADC5_USB_IN_I>;
+				qcom,pre-scaling = <1 1>;
+				label = "usb_in_i_uv";
+			};
+
+			channel@8 {
+				reg = <ADC5_USB_IN_V_16>;
+				qcom,pre-scaling = <1 16>;
+				label = "usb_in_v_div_16";
+			};
+
 			channel@9 {
 				reg = <ADC5_CHG_TEMP>;
 				qcom,pre-scaling = <1 1>;
@@ -150,6 +182,14 @@ pm8150b_adc_tm: adc-tm@3500 {
 			status = "disabled";
 		};

+		pm8150b_fg: fuel-gauge@4000 {
+			compatible = "qcom,pm8150b-fg";
+			reg = <0x4000>;
+			interrupts = <0x2 0x40 0x3 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "soc-delta";
+			status = "disabled";
+		};
+
 		pm8150b_gpios: gpio@c000 {
 			compatible = "qcom,pm8150b-gpio", "qcom,spmi-gpio";
 			reg = <0xc000>;
diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodle.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodle.dts
index 5257d2609..9d7fd0800 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodle.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodle.dts
@@ -1264,6 +1264,23 @@ channel@4f {
 		qcom,hw-settle-time = <200>;
 		label = "conn_therm";
 	};
+
+	/* Charger port ADC channels, ported from WuerfelDev/linux-sm8250
+	 * (branch 6.17.0-instantnoodle) - required by &pm8150b_charger below.
+	 * ADC5_CHG_TEMP already exists upstream as channel@9 in pm8150b.dtsi,
+	 * reused as-is, not duplicated here.
+	 */
+	channel@83 {
+		reg = <ADC5_VPH_PWR>;
+		qcom,pre-scaling = <1 3>;
+		label = "vph_pwr";
+	};
+
+	channel@99 {
+		reg = <ADC5_SBUx>;
+		qcom,pre-scaling = <1 3>;
+		label = "chg_sbux";
+	};
 };

 &pm8150b_adc_tm {
@@ -1277,6 +1294,29 @@ conn-therm@0 {
 	};
 };

+/* Charger and fuel-gauge support, ported from WuerfelDev/linux-sm8250
+ * (branch 6.17.0-instantnoodle). Xo666's own tree has zero charger/fg
+ * nodes at all - see docs/verification-log.md section 1.4/4 in the main
+ * steamos-android repo for the fork-divergence background. Untested on
+ * real hardware - compile-verified only.
+ */
+&pm8150b_fg {
+	status = "okay";
+	monitored-battery = <&battery>;
+	power-supplies = <&pm8150b_charger>;
+};
+
+&pm8150b_charger {
+	io-channels = <&pm8150b_adc ADC5_USB_IN_I>,
+		      <&pm8150b_adc ADC5_USB_IN_V_16>,
+		      <&pm8150b_adc ADC5_SBUx>,
+		      <&pm8150b_adc ADC5_VPH_PWR>,
+		      <&pm8150b_adc ADC5_CHG_TEMP>;
+	io-channel-names = "usb_in_i_uv", "usb_in_v_div_16", "chg_sbux", "vph_pwr", "chg_temp";
+	monitored-battery = <&battery>;
+	status = "okay";
+};
+
 &pm8150b_typec {
 	vdd-pdphy-supply = <&vreg_l2a_3p1>;
 	status = "okay";

# Reference: <https://postmarketos.org/vendorkernel>
# DRAFT - not yet built through abuild/pmbootstrap. A plain cross-compile of
# this exact source+defconfig combination (op8_defconfig, GCC 13 aarch64
# cross toolchain via gcc-aarch64-linux-gnu, Ubuntu 24.04 host) was verified
# to succeed outside the packaging system on 2026-08-24; see
# docs/verification-log.md. This APKBUILD wraps that into the pmaports/abuild
# convention, but uses LLVM/clang (ARCH=arm64 LLVM=1) instead of a GCC cross
# toolchain package, matching the makedepends/build() convention of the
# packaged device/community/linux-postmarketos-qcom-sm8250 kernel - there is
# no "gcc-aarch64-linux-gnu-cross-toolchain" package in Alpine/pmaports (a
# first attempt using that name failed with "dependency not found"). Not
# re-verified with LLVM specifically yet, only that the source is buildable
# in general.
maintainer=""
_flavor="oneplus-instantnoodle"
pkgname=linux-$_flavor
pkgver=6.16.7
pkgrel=2
pkgdesc="OnePlus 8 (instantnoodle) mainline kernel, Xo666 fork"
arch="aarch64"
_carch="arm64"
_config="op8_defconfig"
url="https://github.com/Xo666/mainline-instantnoodle"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	clang
	findutils
	flex
	lld
	llvm
	openssl-dev
	perl
	postmarketos-installkernel
	python3
"

# Source: Xo666/mainline-instantnoodle, branch 6.16.7 (see verification-log.md
# section 1.4 for why this fork and not ObiKeahloa's or WuerfelDev's - this is
# the only one of the three with a complete, working zap-shader wiring for
# the GPU, which is a hard prerequisite for the whole gaming-stack project).
# NOTE: this branch had no pm8150b_charger node at all (see verification-log.md
# section 4) - 0001-port-charger-fg-from-wuerfeldev.patch ports the charger
# and fuel-gauge nodes over from WuerfelDev/linux-sm8250 (branch
# 6.17.0-instantnoodle), which has working charging but ships with the GPU
# disabled. The patch is compile-verified (raw dtc build and a full
# pmbootstrap/abuild package build, both zero errors on the changed nodes)
# but NOT tested on real hardware - see docs/verification-log.md for the
# exact verification done and what it does and does not prove.
source="
	$pkgname-$pkgver.tar.gz::https://github.com/Xo666/mainline-instantnoodle/archive/refs/heads/$pkgver.tar.gz
	0001-port-charger-fg-from-wuerfeldev.patch
"
builddir="$srcdir/mainline-instantnoodle-$pkgver"

prepare() {
	default_prepare
	make ARCH="$_carch" LLVM=1 "$_config"
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$pkgrel-$_flavor" \
		Image.gz dtbs modules
}

package() {
	mkdir -p "$pkgdir"/boot

	make ARCH="$_carch" LLVM=1 \
		zinstall modules_install dtbs_install \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	# mkinitfs scans /usr/share/kernel/*/kernel.release to find installed
	# kernels - without this file it reports "found: []" and fails, even
	# though the actual vmlinuz/modules are present under boot/ and
	# lib/modules/. Missing from the first draft; found by diffing against
	# the working device/community/linux-postmarketos-qcom-sm8250 package
	# after a real `pmbootstrap install` failed with exactly that error.
	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

